# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# non-local env (EXPO_PUBLIC_* are public, but keep them out of git)
.env

# local tooling
.claude/
.vercel
src/features/eerc/prover/snarkjsSource.gen.ts

# Firebase client config — stays out of the public repo; EAS gets it as a file
# secret (GOOGLE_SERVICES_JSON), local builds read the untracked file.
google-services.json
