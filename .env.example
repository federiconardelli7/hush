# ─────────────────────────────────────────────────────────────────────────────
# Hush — environment variables. Copy to `.env` (or `.env.local`) and fill the blanks.
# `.env` and `.env*.local` are gitignored — NEVER commit real secrets.
#
#  EXPO_PUBLIC_*  → inlined into the CLIENT bundle (public by design; RLS + on-chain
#                   privacy protect the data). Also set these in Vercel →
#                   Project → Settings → Environment Variables (needed at build time).
#  everything else → SERVER/LOCAL-ONLY (migrations, dev backend, admin, MCP). Do NOT
#                    prefix with EXPO_PUBLIC_ or they will leak into the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Chain (public) — our eERC deployment on Avalanche Fuji ──
EXPO_PUBLIC_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
EXPO_PUBLIC_FUJI_CHAIN_ID=43113
EXPO_PUBLIC_EERC_CONTRACT=0x2f7ca5848a4E075EDA36Ba0618b0317f1945648C
EXPO_PUBLIC_ERC20=0x291E3775A266E084b902cD61856234cb55F0ab64

# ── Privy (client) — embedded-wallet auth. dashboard.privy.io → your app ──
EXPO_PUBLIC_PRIVY_APP_ID=

# ── Supabase (client) — Project → Settings → API ──
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Local dev backend URL (client) — faucet + auth token-exchange (scripts/faucet.mjs) ──
EXPO_PUBLIC_FAUCET_URL=http://localhost:8788

# ── Supabase admin / server (LOCAL-ONLY: schema migrations from docs/06 + MCP) ──
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Direct Postgres connection for psql / migrations (uses the DB password above):
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# JWT Secret = the symmetric HS256 signing key (Settings → API → JWT Settings → "JWT Secret",
# a.k.a. "Legacy JWT Secret"). NOT a Secret API key (sb_secret_...). The dev backend uses it
# to mint wallet_address tokens that Supabase RLS trusts.
SUPABASE_JWT_SECRET=

# ── Local dev backend secrets (LOCAL-ONLY: scripts/faucet.mjs) ──
# Dedicated throwaway key that drips Fuji gas to fresh embedded wallets (so users need no
# external wallet). Generated once by the app; fund FAUCET_ADDRESS with testnet AVAX.
# NEVER prefix EXPO_PUBLIC_ — this key must stay server-only.
FAUCET_PRIVATE_KEY=
FAUCET_ADDRESS=
# Optional tuning (defaults shown): drip size, recipient skip threshold, port.
# FAUCET_DRIP_AVAX=0.1
# FAUCET_MIN_RECIPIENT=0.05
# FAUCET_PORT=8788

# ── Privy server (OPTIONAL, future) — backend token verification only ──
PRIVY_APP_SECRET=
